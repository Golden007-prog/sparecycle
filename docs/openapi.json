                          "maxLength": 160
                        },
                        "model": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "needs": {
                          "minItems": 1,
                          "maxItems": 6,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
                          }
                        },
                        "repairMinutes": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 600
                        },
                        "priority": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10
                        },
                        "eligible": {
                          "type": "boolean"
                        },
                        "holdReason": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "intakeNote": {
                          "type": "string",
                          "maxLength": 1200
                        },
                        "qaRequired": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "id",
                        "label",
                        "model",
                        "needs",
                        "repairMinutes",
                        "priority",
                        "eligible",
                        "intakeNote",
                        "qaRequired"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "parts": {
                    "maxItems": 40,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
                        },
                        "sku": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "source": {
                          "type": "string",
                          "enum": [
                            "stock",
                            "donor",
                            "purchase"
                          ]
                        },
                        "donorId": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
                        },
                        "quantity": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100
                        },
                        "costCents": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000
                        },
                        "harvestMinutes": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 600
                        },
                        "verified": {
                          "type": "boolean"
                        },
                        "evidenceId": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
                        }
                      },
                      "required": [
                        "id",
                        "sku",
                        "label",
                        "source",
                        "quantity",
                        "costCents",
                        "harvestMinutes",
                        "verified",
                        "evidenceId"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "evidence": {
                    "maxItems": 40,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
                        },
                        "title": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "detail": {
                          "type": "string",
