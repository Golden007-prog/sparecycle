              "limits": {
                "type": "object",
                "properties": {
                  "budgetCents": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "technicianMinutes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "unavailablePartIds": {
                    "maxItems": 40,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
                    }
                  }
                },
                "required": [
                  "budgetCents",
                  "technicianMinutes",
                  "unavailablePartIds"
                ],
                "additionalProperties": false
              },
              "brief": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "action",
              "batch",
              "limits"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "explain"
              },
              "batch": {
                "type": "object",
