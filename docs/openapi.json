          "kind": {
            "type": "string",
            "const": "research"
          },
          "model": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "question": {
            "type": "string",
            "minLength": 10,
            "maxLength": 280
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "findings": {
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "sourceIds": {
                  "minItems": 1,
                  "maxItems": 5,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^S[1-5]$"
                  }
                }
              },
              "required": [
                "text",
                "sourceIds"
              ],
              "additionalProperties": false
            }
          },
          "uncertainties": {
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          },
          "nextChecks": {
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          },
          "sources": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^S[1-5]$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "maxLength": 2048
                },
                "excerpt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                }
              },
              "required": [
                "id",
                "title",
                "url",
                "excerpt"
              ],
              "additionalProperties": false
            }
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "search": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "const": "Tavily"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "keyless",
                  "api-key"
                ]
              },
              "requestId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,128}$"
              },
              "resultCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "credits": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              }
            },
            "required": [
              "provider",
              "mode",
              "resultCount"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "kind",
          "model",
          "question",
          "summary",
          "findings",
          "uncertainties",
          "nextChecks",
          "sources",
          "fetchedAt",
          "search"
        ],
        "additionalProperties": false
      }
    }
  }
}
