{
  "openapi": "3.1.0",
  "info": {
    "title": "SpareCycle API",
    "version": "1.1.0",
    "description": "Review-only intake, bounded recovery planning, and official-source reference research. Server computes allocations; research never approves inventory. See API.md and TAVILY-INTEGRATION.md for request validation, privacy and process-local throttle limitations."
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health",
        "summary": "Report configuration, not live connectivity",
        "responses": {
          "200": {
            "description": "Configuration flags",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "aiConfigured": {
                      "type": "boolean"
                    },
                    "tracingConfigured": {
                      "type": "boolean"
                    },
                    "model": {
                      "type": "string"
                    },
                    "service": {
                      "const": "SpareCycle"
                    },
                    "tavilyConfigured": {
                      "type": "boolean"
                    },
                    "tavilyMode": {
                      "type": "string",
                      "enum": [
                        "keyless",
                        "api-key",
                        "unconfigured"
                      ]
                    }
                  },
                  "required": [
                    "aiConfigured",
                    "tracingConfigured",
                    "model",
                    "service",
                    "tavilyConfigured",
                    "tavilyMode"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/analyze": {
      "post": {
        "operationId": "analyze",
        "summary": "Draft intake, plan recovery, explain allocations, or research official support references",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated model text, deterministic plan for plan/explain, or cited research including explicit empty-source abstention",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or oversized input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Browser origin rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Process-local request quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Invalid model/search output, tool failure, provider error or deadline exceeded; provider content is not returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Nebius or requested research provider is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
