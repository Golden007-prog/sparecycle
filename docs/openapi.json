      "Intake": {
        "type": "object",
        "properties": {
          "devices": {
            "maxItems": 18,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "needs": {
                  "maxItems": 6,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "repairMinutes": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 600
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "note": {
                  "type": "string",
                  "maxLength": 1200
                },
                "missing": {
                  "maxItems": 12,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              },
              "required": [
                "label",
                "model",
                "needs",
                "repairMinutes",
                "note",
                "missing"
              ],
              "additionalProperties": false
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "missing": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
