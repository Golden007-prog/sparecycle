{
  "openapi": "3.1.0",
  "info": {
    "title": "SpareCycle API",
    "version": "1.0.0",
    "description": "Review-only intake and bounded tool-calling recovery planning. Server computes allocations. No inventory persistence or mutation. See API.md for validation refinements, 24KB body and 16KB batch limits, privacy and in-memory throttling limitations."
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health",
        "summary": "Report configuration, not live connectivity",
        "responses": {
          "200": {
            "description": "Configuration flags",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "aiConfigured": {
                      "type": "boolean"
                    },
                    "tracingConfigured": {
                      "type": "boolean"
                    },
                    "model": {
                      "type": "string"
                    },
                    "service": {
                      "const": "SpareCycle"
                    }
                  },
                  "required": [
                    "aiConfigured",
                    "tracingConfigured",
                    "model",
                    "service"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/analyze": {
      "post": {
        "operationId": "analyze",
        "summary": "Draft intake, run the recovery agent, or explain a server plan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated model text and, for plan/explain, authoritative deterministic plan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or oversized input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Browser origin rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Process-local request quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Model response, tool call or provider failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Nebius key is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisRequest": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "intake"
              },
              "text": {
                "type": "string",
                "minLength": 10,
                "maxLength": 6000
              }
            },
            "required": [
              "action",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "plan"
              },
              "batch": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "devices": {
                    "minItems": 1,
                    "maxItems": 18,
                    "type": "array",
                    "items": {
                      "type": "object",
