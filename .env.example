# Copy this file to .env.local. Node 22+ loads it for npm run dev.
# In Vercel, add these values as server-only environment variables.
# Never use VITE_ prefixes for secrets or commit .env.local.
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# Optional LangSmith tracing. Only action/model/tool/status/count metadata is recorded;
# inputs and outputs are hidden. The organization ID in /o/... is NOT the
# workspace ID. Use the actual workspace ID for an organization-scoped key.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=sparecycle
LANGSMITH_WORKSPACE_ID=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional canonical browser origin. When blank, browser Origin must match
# the request Host. CLI clients without an Origin header remain supported.
APP_ORIGIN=
PORT=3000

# Demo API limits: five accepted calls per IP per ten minutes, sixty total
# calls per hour, two concurrent calls overall, one concurrent call per IP.
# Limits are IN MEMORY PER INSTANCE; restarts and horizontal scaling reset or
# multiply them. Production needs authenticated, durable shared quotas and
# a provider spending limit. Never describe these as a hard account budget.

# SpareCycle Review: authenticated organizations. These are SERVER configuration.
# The URL/publishable key are intentionally returned to the auth UI; never use a
# service-role key or sb_secret_* value as the publishable key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Generate a random value of at least 32 characters. Store only its SHA-256 hash
# in review_private.runtime.worker_secret_hash; see docs/review-database.md.
REVIEW_WORKER_SECRET=

# GitHub App credentials. Create/install an App for a new deployment; the hosted
# pilot uses sparecycle-review (App ID 5259249). Never copy the pilot's private key.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
# Optional alternative to slug: https://github.com/apps/YOUR-APP/installations/new
GITHUB_APP_INSTALL_URL=
# PEM may use actual newlines or literal \n sequences; keep it server-only.

# Current public-source verification provider: GitHub Actions isolated containers.
# Select a repository containing the trusted review-verify workflow and scripts.
# The numeric IDs and exact verifier commit must match your own installation.
REVIEW_ACTIONS_REPOSITORY=
REVIEW_ACTIONS_REPOSITORY_ID=
REVIEW_ACTIONS_INSTALLATION_ID=
REVIEW_ACTIONS_REF=
REVIEW_ACTIONS_SHA=
REVIEW_ACTIONS_IMAGE=node:22-alpine@sha256:2c752226d477b4a886378baa95b9af252be59301b725fdb0b7e15208131505a8

# Review model IDs are routed by stage in lib/review/harness.ts. Ultra is opt-in;
# leave false unless account access, budget and escalation behavior are reviewed.
NEBIUS_REVIEW_ALLOW_ULTRA=false

# Optional SEPARATE Nebius Sandboxes beta backend, not required for Token Factory
# inference. Keep blank unless activated and tested; an image selects this backend.
NEBIUS_PROJECT_ID=
NEBIUS_SANDBOX_IMAGE_ID=
# Image must be an immutable UUID with Node 22+ at /usr/local/bin/node.
# SMTP/Auth redirects are configured in Supabase, not through these env variables.
# Full company/operator setup: docs/REVIEW-COMPANY-SETUP.md.
